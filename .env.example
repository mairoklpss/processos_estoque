# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Produção: HTTPS e origem pública exata. Nunca coloque segredos aqui.
# PUBLIC_ORIGIN=https://estoque.seudominio.com.br
# TRUST_PROXY_HOPS=1 # apenas atrás de proxy confiável sem acesso direto ao app

# HOST=127.0.0.1 # desenvolvimento local; produção usa 0.0.0.0 por padrão
# SQLITE_PATH=C:/caminho/seguro/brasilink.sqlite

# Operação atual: PostgreSQL (brasilink_operacao, 127.0.0.1:55433). SQLite é apenas retorno explícito autorizado.
DATABASE_CLIENT=postgres
# DATABASE_URL: definir somente no ambiente/gerenciador de segredos, nunca versionar.
# BACKUP_PASSPHRASE: definir somente no ambiente; não enviar pelo chat.

# Cookies independentes entre operação/homologação mesmo em portas diferentes.
APP_INSTANCE=operacao
