{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -File scripts/local-operacao.ps1 -Action start -Development",
    "start": "powershell -NoProfile -File scripts/local-operacao.ps1 -Action start",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "backup:create": "powershell -NoProfile -File scripts/local-operacao.ps1 -Action backup",
    "backup:sqlite": "powershell -NoProfile -File scripts/local-backup.ps1 -Mode create",
    "backup:decode": "powershell -NoProfile -File scripts/local-operacao.ps1 -Action restore-backup",
    "pg:operacao:up": "powershell -NoProfile -File scripts/local-operacao.ps1 -Action up",
    "pg:operacao:verify": "powershell -NoProfile -File scripts/local-operacao.ps1 -Action verify",
    "pg:operacao:check": "powershell -NoProfile -File scripts/local-operacao.ps1 -Action check",
    "pg:up": "powershell -NoProfile -File scripts/local-postgres.ps1 -Action up",
    "pg:migrate": "powershell -NoProfile -File scripts/local-postgres.ps1 -Action migrate",
    "pg:verify": "powershell -NoProfile -File scripts/local-postgres.ps1 -Action verify",
    "pg:test": "powershell -NoProfile -File scripts/local-postgres.ps1 -Action test",
    "pg:dev": "powershell -NoProfile -File scripts/local-postgres.ps1 -Action start"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
